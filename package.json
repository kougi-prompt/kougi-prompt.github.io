{
  "name": "kougi-prompt-app",
  "version": "1.0.0",
  "private": true,
  "description": "講義プロンプトメーカー（Webサイト版・アプリ版）",
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "preview:site": "node scripts/build-site.mjs && node scripts/serve.mjs site",
    "build": "node scripts/build-web.mjs",
    "sync": "npm run build && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/klee-one": "^5.3.1",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "marked": "^18.0.14"
  }
}
